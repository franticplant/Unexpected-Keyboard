<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="@dimen/clipboard_view_height"
  android:orientation="vertical"
  android:background="?attr/colorKeyboard"
  android:hardwareAccelerated="false">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <CheckBox
      android:id="@+id/clipboard_history_toggle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/clipboard_history_heading"
      android:textSize="13sp"
      android:textColor="?attr/colorSubLabel"/>

    <Button
      android:id="@+id/clipboard_clear"
      style="?android:attr/buttonBarButtonStyle"
      android:layout_width="wrap_content"
      android:layout_height="40dp"
      android:minWidth="0dp"
      android:paddingStart="8dp"
      android:paddingEnd="8dp"
      android:text="@string/clipboard_clear_unpinned"
      android:textAllCaps="false"
      android:textSize="12sp"
      android:textColor="?attr/colorSubLabel"/>
  </LinearLayout>

  <LinearLayout
    android:id="@+id/clipboard_filters"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <Button
      android:id="@+id/clipboard_filter_all"
      style="?android:attr/buttonBarButtonStyle"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:minWidth="0dp"
      android:paddingStart="2dp"
      android:paddingEnd="2dp"
      android:text="@string/clipboard_filter_all"
      android:textAllCaps="false"
      android:textSize="12sp"/>

    <Button
      android:id="@+id/clipboard_filter_text"
      style="?android:attr/buttonBarButtonStyle"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:minWidth="0dp"
      android:paddingStart="2dp"
      android:paddingEnd="2dp"
      android:text="@string/clipboard_filter_text"
      android:textAllCaps="false"
      android:textSize="12sp"/>

    <Button
      android:id="@+id/clipboard_filter_images"
      style="?android:attr/buttonBarButtonStyle"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:minWidth="0dp"
      android:paddingStart="2dp"
      android:paddingEnd="2dp"
      android:text="@string/clipboard_filter_images"
      android:textAllCaps="false"
      android:textSize="12sp"/>

    <Button
      android:id="@+id/clipboard_filter_pinned"
      style="?android:attr/buttonBarButtonStyle"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:minWidth="0dp"
      android:paddingStart="2dp"
      android:paddingEnd="2dp"
      android:text="@string/clipboard_pin_heading"
      android:textAllCaps="false"
      android:textSize="12sp"/>
  </LinearLayout>

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <ListView
      android:id="@+id/clipboard_list"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:divider="?attr/clipboard_divider_color"
      android:dividerHeight="?attr/clipboard_divider_height"
      android:paddingBottom="4dp"
      android:clipToPadding="false"
      android:scrollbars="vertical"/>

    <TextView
      android:id="@+id/clipboard_empty"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:padding="24dp"
      android:text="@string/clipboard_empty"
      android:textSize="14sp"
      android:textColor="?attr/colorSubLabel"
      android:visibility="gone"/>
  </FrameLayout>

  <juloo.keyboard2.Keyboard2View
    layout="@xml/clipboard_bottom_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorKeyboard"/>
</LinearLayout>
